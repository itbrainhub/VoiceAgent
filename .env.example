# Copy to .env and fill in. Never commit .env.
DATABASE_URL=sqlite:///./voiceagent.db
# DATABASE_URL=postgresql+psycopg://voiceagent:voiceagent@localhost:5432/voiceagent

ANTHROPIC_API_KEY=
LIVE_MODEL=claude-haiku-5-5
ANALYSIS_MODEL=claude-sonnet-5-5
LIVE_EFFORT=low

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public HTTPS URL Twilio can reach (e.g. an ngrok URL in development)
PUBLIC_BASE_URL=https://your-public-url.example.com

FEEDBACK_DELAY_MINUTES=30
FEEDBACK_MAX_ATTEMPTS=3
CALLING_HOURS_START=10
CALLING_HOURS_END=21
